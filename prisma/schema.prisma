generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model BankAccount {
  id                String        @id
  userId            String
  plaidItemId       String
  plaidAccountId    String        @unique
  name              String
  officialName      String?
  type              AccountType
  subtype           String?
  mask              String?
  currentBalance    Decimal?      @db.Decimal(19, 4)
  availableBalance  Decimal?      @db.Decimal(19, 4)
  isoCurrencyCode   String?       @default("USD")
  lastBalanceUpdate DateTime?
  isHidden          Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime
  PlaidItem         PlaidItem     @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  User              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  Transaction       Transaction[]

  @@index([userId])
}

model BudgetGoal {
  id             String           @id
  userId         String
  tagId          String?
  category       String?
  periodType     BudgetPeriodType @default(MONTHLY)
  periodAmount   Decimal          @db.Decimal(19, 4)
  startDate      DateTime?        @db.Date
  endDate        DateTime?        @db.Date
  periodStartDay Int?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  Tag            Tag?             @relation(fields: [tagId], references: [id])
  User           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([tagId])
}

model IncomeConfig {
  id                     String       @id
  userId                 String       @unique
  projectedMonthlyIncome Decimal      @db.Decimal(19, 4)
  payFrequency           PayFrequency @default(MONTHLY)
  nextPayDate            DateTime?
  rentAmount             Decimal      @default(0) @db.Decimal(19, 4)
  rentDueDay             Int          @default(1)
  monthlySavingsGoal     Decimal      @default(0) @db.Decimal(19, 4)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime
  onboardingComplete     Boolean      @default(false)
  savingsIsPercent       Boolean      @default(false)
  utilitiesAmount        Decimal      @default(0) @db.Decimal(19, 4)
  User                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NetWorthSnapshot {
  id               String   @id
  userId           String
  date             DateTime @db.Date
  totalAssets      Decimal  @db.Decimal(19, 4)
  totalLiabilities Decimal  @db.Decimal(19, 4)
  netWorth         Decimal  @db.Decimal(19, 4)
  accountBreakdown Json?
  createdAt        DateTime @default(now())
  User             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model PlaidItem {
  id               String          @id
  userId           String
  accessToken      String
  itemId           String          @unique
  institutionId    String?
  institutionName  String?
  consentExpiresAt DateTime?
  lastSyncedAt     DateTime?
  syncCursor       String?
  status           PlaidItemStatus @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime
  BankAccount      BankAccount[]
  User             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavingsGoal {
  id            String    @id
  userId        String
  name          String
  targetAmount  Decimal   @db.Decimal(19, 4)
  currentAmount Decimal   @default(0) @db.Decimal(19, 4)
  targetDate    DateTime? @db.Date
  isComplete    Boolean   @default(false)
  isPrimary     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  User          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DashboardConfig {
  id        String   @id @default(cuid())
  userId    String   @unique
  cards     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tag {
  id           String           @id @default(uuid())
  userId       String
  name         String
  color        String?          @default("#6B7280")
  isSystem     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  User         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]
  budgetGoals  BudgetGoal[]

  @@unique([userId, name])
  @@index([userId])
}

model TransactionTag {
  id            String      @id @default(uuid())
  transactionId String
  tagId         String
  createdAt     DateTime    @default(now())
  Transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  Tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([transactionId, tagId])
  @@index([transactionId])
  @@index([tagId])
}

model Transaction {
  id                 String           @id
  userId             String
  bankAccountId      String
  plaidTransactionId String?          @unique
  amount             Decimal          @db.Decimal(19, 4)
  isoCurrencyCode    String?          @default("USD")
  date               DateTime         @db.Date
  authorizedDate     DateTime?        @db.Date
  name               String
  merchantName       String?
  category           String?
  categoryIconCode   String?
  personalCategory   String?
  isIncome           Boolean          @default(false)
  isPending          Boolean          @default(false)
  isManual           Boolean          @default(false)
  paymentChannel     String?
  location           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime
  BankAccount        BankAccount      @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  User               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags               TransactionTag[]

  @@index([bankAccountId])
  @@index([userId, date])
}

model User {
  id               String             @id
  email            String             @unique
  name             String?
  password         String?
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  Account          Account[]
  BankAccount      BankAccount[]
  BudgetGoal       BudgetGoal[]
  DashboardConfig  DashboardConfig?
  IncomeConfig     IncomeConfig?
  NetWorthSnapshot NetWorthSnapshot[]
  PlaidItem        PlaidItem[]
  SavingsGoal      SavingsGoal[]
  Session          Session[]
  Tag              Tag[]
  Transaction      Transaction[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum AccountType {
  DEPOSITORY
  CREDIT
  LOAN
  INVESTMENT
  OTHER
}

enum PayFrequency {
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
}

enum PlaidItemStatus {
  ACTIVE
  NEEDS_REAUTH
  DISCONNECTED
}

enum BudgetPeriodType {
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}
