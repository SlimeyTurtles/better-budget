# Database
# For local development (DB container only):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/better_budget"
# For full Docker deployment (app + DB containers):
# DATABASE_URL="postgresql://postgres:postgres@db:5432/better_budget"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3001"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Plaid (get from https://dashboard.plaid.com)
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox" # sandbox, development, or production

# Encryption key for Plaid access tokens (AES-256-GCM)
# MUST be exactly 64 hex characters (32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""
